{
  "name": "franky",
  "version": "1.5.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:webpack": "next dev --webpack",
    "dev:https": "next dev --experimental-https --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf .next node_modules && npm install",
    "start:e2e": "cypress open -P cypress",
    "start:e2e:mobile": "cypress open -P cypress --config-file cypress.config.mobile.ts",
    "test:e2e": "cypress run -P cypress -b firefox",
    "test:e2e:mobile": "cypress run -P cypress -b firefox --config-file cypress.config.mobile.ts",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:coverage": "vitest run --project unit --coverage",
    "test:snapshots": "vitest run --project unit --reporter=verbose --testNamePattern=\"[Ss]napshots?\"",
    "test:update-snapshots": "vitest run --project unit --update --testNamePattern=\"[Ss]napshots?\"",
    "test:vrt": "vitest run --project vrt",
    "test:vrt:regenerate-baseline": "vitest run --project vrt --update",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\" --ignore-path .prettierignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,css,md}\" --ignore-path .prettierignore",
    "precommit": "lint-staged && npm run typecheck",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix --no-warn-ignored",
      "prettier --write --ignore-path .prettierignore"
    ],
    "*.{json,css,md}": "prettier --write --ignore-path .prettierignore"
  },
  "dependencies": {
    "@codemirror/theme-one-dark": "6.1.3",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@emoji-mart/data": "1.2.1",
    "@hookform/resolvers": "5.7.1",
    "@mdxeditor/editor": "4.2.0",
    "@prelude.so/js-sdk": "0.13.0",
    "@sentry/nextjs": "^10.70.0",
    "@serwist/next": "9.5.12",
    "@synonymdev/pubky": "0.8.0",
    "@tanstack/react-query": "5.101.4",
    "bip39": "3.1.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "dexie": "4.4.4",
    "dexie-react-hooks": "4.4.0",
    "embla-carousel-react": "8.6.0",
    "emoji-mart": "5.6.0",
    "facehash": "0.1.0",
    "jszip": "3.10.1",
    "libphonenumber-js": "1.13.10",
    "linkify-it": "6.1.0",
    "lodash-es": "4.18.1",
    "lucide-react": "1.31.0",
    "motion": "13.1.0",
    "next": "16.3.0",
    "next-themes": "0.4.6",
    "pubky-app-specs": "0.6.2",
    "qrcode.react": "4.2.0",
    "radix-ui": "1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-easy-crop": "6.2.3",
    "react-error-boundary": "6.1.2",
    "react-hook-form": "7.85.0",
    "react-markdown": "10.1.0",
    "react-syntax-highlighter": "16.1.1",
    "react-tweet": "3.3.1",
    "remark-gfm": "4.0.1",
    "serwist": "9.5.12",
    "sharp": "0.35.3",
    "sonner": "2.0.8",
    "tailwind-merge": "3.6.0",
    "undici": "8.10.0",
    "unist-util-visit": "5.1.0",
    "usehooks-ts": "3.1.1",
    "zod": "4.4.3",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@eslint/compat": "2.1.0",
    "@eslint/eslintrc": "3.3.6",
    "@faker-js/faker": "10.5.0",
    "@fontsource-variable/inter-tight": "^5.3.0",
    "@stylistic/eslint-plugin": "5.10.0",
    "@tailwindcss/postcss": "4.3.3",
    "@tailwindcss/typography": "0.5.20",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.3",
    "@types/lodash-es": "4.17.12",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/react-syntax-highlighter": "15.5.13",
    "@vitejs/plugin-react": "6.0.5",
    "@vitest/browser": "4.1.10",
    "@vitest/browser-playwright": "4.1.10",
    "@vitest/coverage-v8": "4.1.10",
    "babel-plugin-react-compiler": "1.0.0",
    "cypress": "15.20.0",
    "cypress-slow-down": "1.4.0",
    "dotenv": "17.4.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.0",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "fake-indexeddb": "6.2.5",
    "husky": "9.1.7",
    "jsdom": "30.0.1",
    "lint-staged": "17.3.0",
    "playwright": "^1.62.1",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "ts-node": "10.9.2",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "vite-tsconfig-paths": "6.1.1",
