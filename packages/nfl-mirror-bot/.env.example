# Copy to .env on the VPS only (never commit .env).
# Phase 2: fill after bot account exists.

# Bot account — 12-word recovery phrase (headless session)
# PUBKY_RECOVERY_PHRASE=

# Bluesky upstream (Phase 5+)
# BLUESKY_SOURCE_HANDLE=nflnewsreposterbot.bsky.social
# JETSTREAM_URL=wss://jetstream2.us-east.bsky.network/subscribe

# SQLite state path on server (Phase 4+)
# SQLITE_PATH=/var/lib/pubky-bot/state.sqlite
